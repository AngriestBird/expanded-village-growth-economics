SELF_VERSION <- 1100             // integer version of the GS, needs to be increased with each release
SELF_MINLOADVERSION <- 1000      // minimum integer version of GS that can load this version, increased when major version is increased
SELF_MAJORVERSION <- 1            // main version of the GS, releases with same major version should be saveload compatible
SELF_MINORVERSION <- 1            // minor version of the GS, incremental subreleases of the major version, saveload compatible
SELF_PATCHVERSION <- 0            // patch version of the GS, not used for save compatibility
SELF_DATE <- "2026-07-18"       // release date [YYYY-MM-DD]
SELF_MAX_TOWNS <- 2000          // maximum number of towns that can be successfully saved in this release
